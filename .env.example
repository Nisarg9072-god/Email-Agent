# Email provider: "mock" (default) or "gmail"
EMAIL_PROVIDER=mock

# LLM provider: "mock" (offline demo/tests) or "mistral" (production)
LLM_PROVIDER=mock

# Mistral AI credentials (required when LLM_PROVIDER=mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Database path (optional, defaults to data/agent.db)
DATABASE_URL=sqlite:///data/agent.db

# Gmail credentials (only needed when EMAIL_PROVIDER=gmail)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# Only process messages matching this Gmail search (default: unread in inbox)
GMAIL_QUERY=in:inbox is:unread
# Max unread Gmail messages to fetch per agent run (default 50)
GMAIL_MAX_MESSAGES_PER_RUN=50
GMAIL_UNREAD_SCAN_LIMIT=100
GMAIL_MARK_READ_AFTER_PROCESSING=true

# Agent limits
MAX_AGENT_STEPS=50
MAX_AGENT_TURNS_PER_EMAIL=15
MAX_TOOL_CALLS=10
MISTRAL_MAX_RETRIES=3

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Continuous mode: keep checking mail and replying until you press Ctrl+C
AGENT_CONTINUOUS_MODE=false
AGENT_POLL_INTERVAL_SECONDS=60
